<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dayflow_leave_decision_email_template" model="mail.template">
        <field name="name">Dayflow: Leave Request Decision</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="subject">Your leave request has been {{ object.state == 'validate' and 'Approved' or 'Rejected' }}</field>
        <field name="email_to">{{ object.employee_id.work_email or object.employee_id.private_email }}</field>
        <field name="body_html" type="html">
            <div style="font-family: sans-serif;">
                <p>Hi <t t-out="object.employee_id.name"/>,</p>
                <p>
                    Your leave request from <t t-out="object.date_from"/> to <t t-out="object.date_to"/>
                    has been
                    <strong t-out="object.state == 'validate' and 'approved' or 'rejected'"/>.
                </p>
                <p t-if="object.state != 'validate'">
                    Reason / comments: <t t-out="object.report_note or 'None provided'"/>
                </p>
                <p>— Dayflow HRMS</p>
            </div>
        </field>
    </record>
</odoo>
