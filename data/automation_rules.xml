<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dayflow_leave_decision_server_action" model="ir.actions.server">
        <field name="name">Dayflow: Send leave decision email</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="state">code</field>
        <field name="code">
template = env.ref('dayflow_hrms.dayflow_leave_decision_email_template', raise_if_not_found=False)
if not template:
    template = env.ref('dayflow-hrms.dayflow_leave_decision_email_template', raise_if_not_found=False)
if template:
    for leave in records:
        template.send_mail(leave.id, force_send=True)
        </field>
    </record>

    <record id="dayflow_leave_decision_automation" model="base.automation">
        <field name="name">Dayflow: Notify employee of leave decision</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="trigger">on_write</field>
        <field name="trigger_field_ids" eval="[(4, ref('hr_holidays.field_hr_leave__state'))]"/>
        <field name="filter_pre_domain">[('state', 'not in', ['validate', 'refuse'])]</field>
        <field name="filter_domain">[('state', 'in', ['validate', 'refuse'])]</field>
        <field name="action_server_ids" eval="[(6, 0, [ref('dayflow_leave_decision_server_action')])]"/>
        <field name="active">True</field>
    </record>
</odoo>