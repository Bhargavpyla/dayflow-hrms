<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        We deliberately do NOT create new groups. Odoo already ships:
          - base.group_user           -> "Employee" access level
          - hr.group_hr_user          -> "HR Officer"
          - hr.group_hr_manager       -> "HR Administrator"
        Dayflow's "Admin vs Employee" requirement maps directly onto these.
    -->

    <record id="dayflow_salary_slip_rule_employee" model="ir.rule">
        <field name="name">Dayflow Salary Slip: employee sees own only</field>
        <field name="model_id" ref="model_dayflow_salary_slip"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="dayflow_salary_slip_rule_hr" model="ir.rule">
        <field name="name">Dayflow Salary Slip: HR sees all</field>
        <field name="model_id" ref="model_dayflow_salary_slip"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
</odoo>
